-- Task 1 (IN)
SELECT FIRST_NAME, 
       LAST_NAME, 
       DEPARTMENT_ID
FROM HR.EMPLOYEES
WHERE DEPARTMENT_ID IN (
    SELECT DEPARTMENT_ID
    FROM HR.DEPARTMENTS
    WHERE DEPARTMENT_NAME IN ('Marketing', 'Purchasing', 'IT')
);

-- Task 1 (EXISTS)
SELECT e.FIRST_NAME, 
       e.LAST_NAME, 
       e.DEPARTMENT_ID
FROM HR.EMPLOYEES e
WHERE EXISTS (
    SELECT 1
    FROM HR.DEPARTMENTS d
    WHERE d.DEPARTMENT_ID = e.DEPARTMENT_ID
      AND d.DEPARTMENT_NAME IN ('Marketing', 'Purchasing', 'IT')
);









-- Task 2
SELECT m.EMPLOYEE_ID, 
       m.FIRST_NAME, 
       m.LAST_NAME
FROM HR.EMPLOYEES m
WHERE EXISTS (
    SELECT 1
    FROM HR.EMPLOYEES e
    WHERE e.MANAGER_ID = m.EMPLOYEE_ID
);










-- Task 3
-- a) '2026/12/31'
SELECT TO_CHAR(
    TO_DATE('2026/12/31', 'YYYY/MM/DD'), 'DD.MM.YYYY HH24:MI') AS TARIX_A
FROM DUAL;

-- b) '31-12-2026 23:59'
SELECT TO_CHAR(
    TO_DATE('31-12-2026 23:59', 'DD-MM-YYYY HH24:MI'), 'DD.MM.YYYY HH24:MI') AS TARIX_B
FROM DUAL;

-- c) '20261231'
SELECT TO_CHAR(
    TO_DATE('20261231', 'YYYYMMDD'), 'DD.MM.YYYY HH24:MI') AS TARIX_C
FROM DUAL;

-- d) 'December 31, 2026'
SELECT TO_CHAR(
    TO_DATE('December 31, 2026', 'Month DD, YYYY', 'NLS_DATE_LANGUAGE = AMERICAN'), 'DD.MM.YYYY HH24:MI') AS TARIX_D
FROM DUAL;

-- e) '2026@12@31  08:30'
SELECT TO_CHAR(
    TO_DATE('2026@12@31  08:30', 'YYYY@MM@DD  HH24:MI'), 'DD.MM.YYYY HH24:MI') AS TARIX_E
FROM DUAL;







-- Task 4 a) DATE literalı ilə
SELECT FIRST_NAME, 
       LAST_NAME, 
       HIRE_DATE
FROM HR.EMPLOYEES
WHERE HIRE_DATE >= DATE '2008-01-01'
ORDER BY HIRE_DATE ASC;

-- Task 4 b) TO_DATE ilə
SELECT FIRST_NAME, 
       LAST_NAME, 
       HIRE_DATE
FROM HR.EMPLOYEES
WHERE HIRE_DATE >= TO_DATE('01.01.2008', 'DD.MM.YYYY')
ORDER BY HIRE_DATE ASC;








-- Task 5 a) NOT EXISTS ilə
SELECT e.EMPLOYEE_ID, 
       e.FIRST_NAME, 
       e.LAST_NAME, 
       e.DEPARTMENT_ID
FROM HR.EMPLOYEES e
WHERE NOT EXISTS (
    SELECT 1
    FROM HR.DEPARTMENTS d
    WHERE d.DEPARTMENT_ID = e.DEPARTMENT_ID
);

-- Task 5 b) NOT IN ilə
SELECT EMPLOYEE_ID, 
       FIRST_NAME,
       LAST_NAME, 
       DEPARTMENT_ID
FROM HR.EMPLOYEES
WHERE DEPARTMENT_ID NOT IN (
    SELECT DEPARTMENT_ID
    FROM HR.DEPARTMENTS
);









-- Task 6 a) NOT IN ilə
SELECT EMPLOYEE_ID, 
       FIRST_NAME, 
       LAST_NAME
FROM HR.EMPLOYEES
WHERE DEPARTMENT_ID = 50
  AND EMPLOYEE_ID NOT IN (
      SELECT MANAGER_ID
      FROM HR.EMPLOYEES
  );

-- Task 6 b) NOT EXISTS ilə
SELECT e.EMPLOYEE_ID, 
       e.FIRST_NAME, 
       e.LAST_NAME
FROM HR.EMPLOYEES e
WHERE e.DEPARTMENT_ID = 50
  AND NOT EXISTS (
      SELECT 1
      FROM HR.EMPLOYEES sub
      WHERE sub.MANAGER_ID = e.EMPLOYEE_ID
  );

-- Task 6 c) Düzəldilmiş NOT IN ilə
SELECT EMPLOYEE_ID, 
       FIRST_NAME, 
       LAST_NAME
FROM HR.EMPLOYEES
WHERE DEPARTMENT_ID = 50
  AND EMPLOYEE_ID NOT IN (
      SELECT MANAGER_ID
      FROM HR.EMPLOYEES
      WHERE MANAGER_ID IS NOT NULL
  );









  -- Task 7 a) TO_DATE ilə >= və <
SELECT FIRST_NAME, 
       LAST_NAME, 
       HIRE_DATE
FROM HR.EMPLOYEES
WHERE HIRE_DATE >= TO_DATE('01.07.2006', 'DD.MM.YYYY')
  AND HIRE_DATE <  TO_DATE('01.01.2007', 'DD.MM.YYYY')
ORDER BY HIRE_DATE ASC;

-- Task 7 b) TO_DATE ilə BETWEEN
SELECT FIRST_NAME, 
       LAST_NAME, 
       HIRE_DATE
FROM HR.EMPLOYEES
WHERE HIRE_DATE BETWEEN TO_DATE('01.07.2006', 'DD.MM.YYYY')
                    AND TO_DATE('31.12.2006', 'DD.MM.YYYY')
ORDER BY HIRE_DATE ASC;








-- Task 8 a) EXISTS ilə və DATE literalı ilə
SELECT d.DEPARTMENT_ID, 
       d.DEPARTMENT_NAME
FROM HR.DEPARTMENTS d
WHERE EXISTS (
    SELECT 1
    FROM HR.EMPLOYEES e
    WHERE e.DEPARTMENT_ID = d.DEPARTMENT_ID
      AND e.HIRE_DATE >= DATE '2007-01-01'
);

-- Task 8 b) IN ilə
SELECT DEPARTMENT_ID, 
       DEPARTMENT_NAME
FROM HR.DEPARTMENTS
WHERE DEPARTMENT_ID IN (
    SELECT DEPARTMENT_ID
    FROM HR.EMPLOYEES
    WHERE HIRE_DATE >= DATE '2007-01-01'
);











-- Task 9
SELECT FIRST_NAME, 
       HIRE_DATE
FROM HR.EMPLOYEES E
WHERE HIRE_DATE >= TO_DATE('15/03/2006', 'DD/MM/YYYY')
  AND EXISTS (
      SELECT 1
      FROM HR.DEPARTMENTS D
      WHERE D.DEPARTMENT_ID = E.DEPARTMENT_ID
        AND D.DEPARTMENT_NAME = 'Sales'
  );










  -- Task 10
SELECT TO_DATE('1999@07@23', 'YYYY@MM@DD') AS DOGUM_TARIXI,
       TRUNC(MONTHS_BETWEEN(SYSDATE, TO_DATE('1999@07@23', 'YYYY@MM@DD')) / 12) AS YAS,
       TRIM(TO_CHAR(TO_DATE('1999@07@23', 'YYYY@MM@DD'), 'DAY', 'NLS_DATE_LANGUAGE = AMERICAN')) AS GUN
FROM DUAL;
