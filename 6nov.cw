-- TASK1

SELECT FIRST_NAME,
       LAST_NAME,
       SALARY,
       COMMISSION_PCT,
       NVL(COMMISSION_PCT, 0) AS DUZELDILMIS_KOMISIYYA 
FROM HR.EMPLOYEES; -- NVL REPLACE EDIR 





-- TASK2
SELECT FIRST_NAME,
       LAST_NAME,
       SALARY
FROM HR.EMPLOYEES
WHERE lower(LAST_NAME) = 'king'; -- pythondaki ile eyni mentiq 





-- TASK3
SELECT FIRST_NAME,
       LAST_NAME,
       HIRE_DATE
FROM HR.EMPLOYEES
WHERE HIRE_DATE >= TO_DATE ('2006-01-01','YYYY-MM-DD');





-- TASK4
SELECT FIRST_NAME,
       LAST_NAME,
       ROUND(MONTHS_BETWEEN(SYSDATE, HIRE_DATE)) AS IS_MUDDETI
FROM HR.EMPLOYEES;





-- TASK5
SELECT FIRST_NAME,
       LAST_NAME,
       PHONE_NUMBER
FROM HR.EMPLOYEES
WHERE PHONE_NUMBER LIKE '1.515%';





-- TASK6
SELECT JOB_TITLE,
       MIN_SALARY
FROM HR.JOBS
WHERE MIN_SALARY < 3000
ORDER BY MIN_SALARY DESC;





-- TASK7
SELECT CITY,
       STREET_ADDRESS
FROM HR.LOCATIONS
WHERE POSTAL_CODE IS NULL;





-- TASK8
SELECT FIRST_NAME,
       LAST_NAME,
       SALARY || ' USD' AS MAAS_VALUTA
FROM HR.EMPLOYEES;





-- TASK9
SELECT COUNT(MAX_SALARY)
FROM HR.JOBS
WHERE MAX_SALARY > 20000;





-- TASK10
SELECT FIRST_NAME, 
       HIRE_DATE
FROM HR.EMPLOYEES
WHERE (HIRE_DATE BETWEEN TO_DATE('2005-01-01', 'YYYY-MM-DD') 
                    AND TO_DATE('2005-12-31', 'YYYY-MM-DD'));





-- TASK11
SELECT FIRST_NAME,
       ROUND(SALARY, 2) AS BRUTO_MAAS,
       ROUND(SALARY*0.8, 2) AS NET_MAAS       
FROM HR.EMPLOYEES
WHERE DEPARTMENT_ID = 80;





-- TASK12
SELECT FIRST_NAME,
       HIRE_DATE,
       JOB_ID
FROM HR.EMPLOYEES
WHERE (HIRE_DATE BETWEEN TO_DATE('2003-01-01', 'YYYY-MM-DD') 
                    AND TO_DATE('2005-12-31', 'YYYY-MM-DD'));
AND JOB_ID <> 'IT_PROG';







-- TASK13
SELECT COUNT(COMMISSION_PCT),
       ROUND(AVG(SALARY), -1) AS ORTALAMA_MAAS
FROM HR.EMPLOYEES
WHERE COMMISSION_PCT IS NOT NULL;





-- TASK14
SELECT FIRST_NAME,
       SALARY
FROM HR.EMPLOYEES
WHERE MANAGER_ID IS NOT NULL AND DEPARTMENT_ID IS NOT NULL
ORDER BY SALARY DESC
FETCH FIRST 3 ROWS ONLY;





-- TASK15
SELECT FIRST_NAME,
       LAST_NAME,
       HIRE_DATE
FROM HR.EMPLOYEES
WHERE EXTRACT(DAY FROM HIRE_DATE) > 15
AND SALARY BETWEEN 5000 AND 12000; -- EXTRACT CIXARIR  MESELLEN BURADA GUNU ISTIFADE ETMEK LAZIM -HIRE COLUMNDAN CIXARIR 










-- TASK1
SELECT FIRST_NAME,
       LAST_NAME,
       JOB_ID
FROM HR.EMPLOYEES
WHERE LOWER(FIRST_NAME) = 'david';




-- TASK2 
SELECT FIRST_NAME,
       LAST_NAME,
       HIRE_DATE
FROM HR.EMPLOYEES
WHERE HIRE_DATE < TO_DATE ('31-12-2007', 'DD-MM-YYYY');





-- TASK3
SELECT CITY,
       POSTAL_CODE
FROM HR.LOCATIONS
WHERE POSTAL_CODE LIKE '9%';





-- TASK4 
SELECT JOB_TITLE
FROM HR.JOBS
WHERE MAX_SALARY >10000
ORDER BY MAX_SALARY ASC;





-- TASK5 
SELECT DEPARTMENT_NAME,
       MANAGER_ID
FROM HR.DEPARTMENTS
WHERE MANAGER_ID IS NOT NULL;




-- TASK6 
SELECT FIRST_NAME,
       DEPARTMENT_ID || '-DEPT' AS SOBE_KODU
FROM HR.EMPLOYEES;



-- TASK7 
SELECT COUNT(FIRST_NAME)
FROM HR.EMPLOYEES
WHERE JOB_ID = 'ST_CLERK';



-- TASK8
SELECT FIRST_NAME,
       HIRE_DATE
FROM HR.EMPLOYEES
WHERE (HIRE_DATE BETWEEN TO_DATE('01-01-2008','DD-MM-YYYY')
                AND TO_DATE('31-01-2012','DD-MM-YYYY'));





-- TASK9
SELECT FIRST_NAME,
       LAST_NAME,
       COMMISSION_PCT
FROM HR.EMPLOYEES
WHERE COMMISSION_PCT >= 0.15;





-- TASK10
SELECT JOB_TITLE
FROM HR.JOBS
ORDER BY MAX_SALARY DESC
FETCH FIRST 3 ROWS ONLY;



-- TASK11
SELECT FIRST_NAME,
       SALARY,
       (SALARY * 0.10) + (SALARY * NVL(COMMISSION_PCT, 0)) AS BONUS
FROM HR.EMPLOYEES
WHERE DEPARTMENT_ID = 80;



-- TASK12 
SELECT FIRST_NAME,
       LAST_NAME,
       HIRE_DATE
FROM HR.EMPLOYEES
WHERE EXTRACT(YEAR FROM HIRE_DATE) > 2004
AND EXTRACT (MONTH FROM HIRE_DATE) = 6;




-- TASK13
SELECT MIN(SALARY),
       MAX(SALARY),
       ROUND(AVG(SALARY), -1)
FROM HR.EMPLOYEES
WHERE DEPARTMENT_ID = 50;





-- TASK14
SELECT FIRST_NAME,
       LAST_NAME,
       ROUND(SALARY * 12, 2) AS ILLIK_BRUTO,
       ROUND((SALARY * 12)*0.15, 2) AS ILLIK_VERGI,
       ROUND((SALARY * 12)*0.85, 2) AS ILLIK_NET
FROM HR.EMPLOYEES;
