-- Task 1
SELECT MANAGER_ID,
       COUNT(*) AS ISCI_SAYI
FROM HR.EMPLOYEES
WHERE MANAGER_ID IS NOT NULL
GROUP BY MANAGER_ID
ORDER BY ISCI_SAYI DESC;






-- Task 2
SELECT COUNTRY_ID, 
       COUNT(*) AS OFIS_SAYI
FROM HR.LOCATIONS
GROUP BY COUNTRY_ID
ORDER BY OFIS_SAYI DESC;






-- Task 3
SELECT e.FIRST_NAME, 
       e.LAST_NAME, 
       j.JOB_TITLE
FROM HR.EMPLOYEES e
JOIN HR.JOBS j 
ON e.JOB_ID = j.JOB_ID;






-- Task 4
SELECT DEPARTMENT_ID,
       ROUND(AVG(SALARY), 2) AS ORTA_MAAS
FROM HR.EMPLOYEES
GROUP BY DEPARTMENT_ID
HAVING AVG(SALARY) > 8000;






-- Task 5
SELECT DEPARTMENT_ID,
       COUNT(*) AS ISCI_SAYI
FROM HR.EMPLOYEES
WHERE SALARY >= 3000
GROUP BY DEPARTMENT_ID
HAVING COUNT(*) > 3;






-- Task 6
SELECT j.JOB_TITLE, 
       COUNT(e.EMPLOYEE_ID) AS ISCI_SAYI
FROM HR.EMPLOYEES e
JOIN HR.JOBS j 
ON e.JOB_ID = j.JOB_ID
GROUP BY j.JOB_TITLE
ORDER BY ISCI_SAYI DESC;






-- Task 7
SELECT l.CITY, 
       l.COUNTRY_ID
FROM HR.LOCATIONS l
LEFT JOIN HR.DEPARTMENTS d 
ON l.LOCATION_ID = d.LOCATION_ID
WHERE d.LOCATION_ID IS NULL;






-- Task 8
-- Səhv 1: ON E.JOB_ID = JOB_ID hissəsində ikinci JOB_ID-nin hansı cədvələ (J yoxsa E) aid olduğu göstərilməyib.
-- Səhv 2: E.LAST_NAME də SELECT-də var, lakin GROUP BY-da yoxdur.
-- Səhv 3: HAVING AVG(E.SALARY) > 10000 əvəzinə  WHERE istifadə olunub.

SELECT J.JOB_TITLE, 
       ROUND(AVG(E.SALARY), 2) AS ORTA_MAAS
FROM HR.EMPLOYEES E
JOIN HR.JOBS J 
ON E.JOB_ID = J.JOB_ID
GROUP BY J.JOB_TITLE
HAVING AVG(E.SALARY) > 10000;






-- Task 9
SELECT l.CITY, 
       COUNT(e.EMPLOYEE_ID) AS ISCI_SAYI, 
       ROUND(AVG(e.SALARY)) AS ORTA_MAAS
FROM HR.EMPLOYEES e
JOIN HR.DEPARTMENTS d 
ON e.DEPARTMENT_ID = d.DEPARTMENT_ID
JOIN HR.LOCATIONS l 
ON d.LOCATION_ID = l.LOCATION_ID
GROUP BY l.CITY
HAVING COUNT(e.EMPLOYEE_ID) > 5
ORDER BY ISCI_SAYI DESC;






-- Task 10
SELECT d.DEPARTMENT_NAME, 
       NVL(COUNT(e.EMPLOYEE_ID), 0) AS ISCI_SAYI
FROM HR.DEPARTMENTS d
LEFT JOIN HR.EMPLOYEES e 
ON d.DEPARTMENT_ID = e.DEPARTMENT_ID
GROUP BY d.DEPARTMENT_NAME
ORDER BY ISCI_SAYI DESC, d.DEPARTMENT_NAME ASC;
