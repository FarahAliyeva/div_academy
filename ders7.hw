-- Task 1
SELECT FIRST_NAME,
       SALARY,
       MIN(SALARY) OVER() AS EN_ASAGI,
       ROUND(SALARY / MIN(SALARY) OVER(), 1) AS NECE_DEFE
FROM HR.EMPLOYEES
ORDER BY SALARY DESC;







-- Task 2
SELECT FIRST_NAME,
       JOB_ID,
       SALARY,
       ROUND(AVG(SALARY) OVER(PARTITION BY JOB_ID)) AS VEZIFE_ORTASI
FROM HR.EMPLOYEES
ORDER BY JOB_ID;







-- Task 3
SELECT FIRST_NAME,
       SALARY,
       RANK() OVER(ORDER BY SALARY DESC) AS RANK_YER,
       DENSE_RANK() OVER(ORDER BY SALARY DESC) AS DENSE_YER
FROM HR.EMPLOYEES
ORDER BY SALARY DESC;







-- Task 4
SELECT FIRST_NAME,
       MANAGER_ID,
       KOMANDA_SAYI,
       KOMANDA_ORTASI
FROM (
    SELECT FIRST_NAME,
           MANAGER_ID,
           COUNT(*) OVER(PARTITION BY MANAGER_ID) AS KOMANDA_SAYI,
           ROUND(AVG(SALARY) OVER(PARTITION BY MANAGER_ID)) AS KOMANDA_ORTASI
    FROM HR.EMPLOYEES
)
WHERE KOMANDA_SAYI > 6;











-- Task 5
SELECT FIRST_NAME,
       DEPARTMENT_ID,
       SALARY,
       SOBE_MAX,
       CASE
           WHEN SALARY = SOBE_MAX THEN 'Lider'
           ELSE '-'
       END AS STATUS
FROM (
    SELECT FIRST_NAME,
           DEPARTMENT_ID,
           SALARY,
           MAX(SALARY) OVER(PARTITION BY DEPARTMENT_ID) AS SOBE_MAX
    FROM HR.EMPLOYEES
);










-- Task 6
SELECT FIRST_NAME,
       JOB_ID,
       SALARY,
       YER
FROM (
    SELECT FIRST_NAME,
           JOB_ID,
           SALARY,
           DENSE_RANK() OVER(PARTITION BY JOB_ID ORDER BY SALARY DESC) AS YER
    FROM HR.EMPLOYEES
)
WHERE JOB_ID = 'SA_REP'
  AND YER <= 3;












  -- Task 7 a) GROUP BY və HAVING ilə
SELECT JOB_ID,
       COUNT(*) AS ISCI_SAYI,
       AVG(SALARY) AS ORTA_MAAS
FROM HR.EMPLOYEES
GROUP BY JOB_ID
HAVING AVG(SALARY) > 10000;

-- Task 7 b) Window funksiyası ilə (PARTITION BY JOB_ID)
SELECT JOB_ID,
       ISCI_SAYI,
       ORTA_MAAS
FROM (
    SELECT DISTINCT JOB_ID,
           COUNT(*) OVER(PARTITION BY JOB_ID) AS ISCI_SAYI,
           AVG(SALARY) OVER(PARTITION BY JOB_ID) AS ORTA_MAAS
    FROM HR.EMPLOYEES
)
WHERE ORTA_MAAS > 10000;







-- Task 8
SELECT FIRST_NAME,
       DEPARTMENT_ID,
       SALARY,
       YER
FROM (
    SELECT FIRST_NAME,
           DEPARTMENT_ID,
           SALARY,
           DENSE_RANK() OVER(PARTITION BY DEPARTMENT_ID ORDER BY SALARY DESC) AS YER
    FROM HR.EMPLOYEES
)
WHERE YER <= 2;












-- Task 9
SELECT FIRST_NAME,
       DEPARTMENT_ID,
       SALARY
FROM (
    SELECT FIRST_NAME,
           DEPARTMENT_ID,
           SALARY,
           DENSE_RANK() OVER(PARTITION BY DEPARTMENT_ID ORDER BY SALARY DESC) AS YER
    FROM HR.EMPLOYEES
)
WHERE YER = 2;















-- Task 10
SELECT DEPARTMENT_ID,
       SOBE_ORTASI,
       SIRKET_ORTASI,
       CASE
           WHEN SOBE_ORTASI > SIRKET_ORTASI THEN 'Yuxari'
           ELSE 'Asagi'
       END AS VEZIYYET
FROM (
    SELECT DISTINCT DEPARTMENT_ID,
           ROUND(AVG(SALARY) OVER(PARTITION BY DEPARTMENT_ID)) AS SOBE_ORTASI,
           ROUND(AVG(SALARY) OVER()) AS SIRKET_ORTASI
    FROM HR.EMPLOYEES
)
ORDER BY DEPARTMENT_ID;
