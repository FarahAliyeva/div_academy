-- Task 1. Maaş artımı
-- Şirkət bütün işçilərin maaşını 10% artırır. HR.EMPLOYEES cədvəlindən işçinin adını, soyadını, indiki maaşını və yeni maaşını göstərin. Yeni maaş sütununun adı YENI_MAAS olsun.

select FIRST_NAME, 
       LAST_NAME, 
       SALARY as INDIKI_MAAS,
       SALARY * 1.1 as YENI_MAAS
from HR.EMPLOYEES;






-- Task 2. Ofis olan ölkələr
-- HR.LOCATIONS cədvəlindən istifadə edərək şirkətin ofisi olan ölkələrin kodlarını göstərin. Hər kod yalnız bir dəfə görünməlidir.

select distinct COUNTRY_ID
from HR.LOCATIONS;






-- Task 3. İki şöbə, iki fərqli şərt
-- HR.EMPLOYEES cədvəlindən elə işçiləri tapın ki: - ya 50-ci şöbədə işləyir və maaşı 3000-dən azdır, - ya da 80-ci şöbədə işləyir və maaşı 10000-dən çoxdur. Adını, şöbəsini və maaşını göstərin.

select FIRST_NAME, 
       DEPARTMENT_ID,
       SALARY
from HR.EMPLOYEES
where (DEPARTMENT_ID = 50 and SALARY < 3000) or (DEPARTMENT_ID = 80 and SALARY > 10000);






-- Task 4. Başlanğıc maaş aralığı
-- HR.JOBS cədvəlindən minimum maaşı (MIN_SALARY) 4000 ilə 6000 arasında olan vəzifələrin adını və minimum maaşını göstərin.

select JOB_TITLE,
       MIN_SALARY
from HR.JOBS
where MIN_SALARY between 4000 and 6000;






-- Task 5. Seçilmiş ölkələrdəki ofislər
-- HR.LOCATIONS cədvəlindən yalnız ABŞ, Böyük Britaniya və Kanadadakı ofislərin şəhərini və ölkə kodunu göstərin. Ölkə kodları: US, UK, CA. Bir neçə OR yazmadan həll edin.

select CITY,
       COUNTRY_ID
from HR.LOCATIONS
where COUNTRY_ID in ('US', 'UK', 'CA');






-- Task 6. Ad axtarışı
-- HR.EMPLOYEES cədvəlindən adı S hərfi ilə başlayan və tam 5 hərfdən ibarət olan, soyadının içində isə a hərfi olan işçilərin adını və soyadını göstərin.

select FIRST_NAME,
       LAST_NAME
from HR.EMPLOYEES
where FIRST_NAME like 'S____' and LAST_NAME like '%a%';






-- Task 7. Rəhbəri olmayan şöbələr
-- HR.DEPARTMENTS cədvəlindən rəhbəri (MANAGER_ID) təyin olunmamış şöbələrin adını göstərin.

select DEPARTMENT_NAME
from HR.DEPARTMENTS
where MANAGER_ID IS NULL;






--Task 8. Maaş fərqi ən böyük olan vəzifələr
-- HR.JOBS cədvəlində hər vəzifə üçün maksimum və minimum maaş arasındakı fərqi hesablayın və sütunu MAAS_FERQI adlandırın. Fərqi ən böyük olan 3 vəzifənin adını və fərqini göstərin.

select
    JOB_TITLE, 
    (MAX_SALARY - MIN_SALARY) as MAAS_FERQI
from HR.JOBS
order by MAAS_FERQI desc
fetch first 3 rows only;








-- Task 9. 80-ci şöbənin hesabatı
-- HR.EMPLOYEES cədvəlindən yalnız 80-ci şöbə üçün bir sətirlik hesabat çıxarın:
-- işçilərin sayı
-- komissiya alan işçilərin sayı
-- orta maaş (vergüldən sonra 2 rəqəm)
-- ən yüksək və ən aşağı maaş arasındakı fərq. Hər sütuna başa düşülən ad verin. 

select count(FIRST_NAME) as IŞÇİ_SAYI,
       count(COMMISSION_PCT) as KOMİSİYYA_ALIR,
       round(avg(SALARY), 2) as ORTALAMA_MAAS,
       (max(SALARY)- min(SALARY)) as ƏN_BÖYÜK_FƏRQ
from HR.EMPLOYEES
where DEPARTMENT_ID = 80;






-- Task 10. Səhvləri tapın
-- Aşağıdakı sorğuda 3 səhv var. Məqsəd: adı A hərfi ilə başlayan və komissiyası olmayan. işçiləri tapmaqdır. Səhvləri düzəldin, düzgün sorğunu yazın və şərhlə qeyd edin ki, hər səhv nə idi.

-- SELECT FIRST_NAME AS AD, SALARY
-- FROM HR.EMPLOYEES
-- WHERE AD LIKE "A%"
--  AND COMMISSION_PCT = NULL;

SELECT 
    FIRST_NAME AS AD, 
    SALARY
FROM HR.EMPLOYEES
WHERE FIRST_NAME LIKE 'A%' 
AND COMMISSION_PCT IS NULL;     



-- Səhv 1: AD əvəzinə FIRST_NAME yazılmalı idi
-- Səhv 2: "A%" əvəzinə tək dırnaqla 'A%' yazılmalı idi
-- Səhv 3: = NULL əvəzinə IS NULL yazılmalı idi  
