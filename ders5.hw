-- Task 1
SELECT
    FIRST_NAME || ' ' || UPPER(LAST_NAME) AS TAM_AD,
    SUBSTR(FIRST_NAME, 1, 1) || '. ' || LAST_NAME AS QISA_AD,
    LOWER(EMAIL) || '@company.com' AS EMAIL
FROM HR.EMPLOYEES
ORDER BY LAST_NAME;


-- Task 2
SELECT
    FIRST_NAME,
    TO_CHAR(SALARY, 'FM999,999') || ' AZN' AS MAAS,
    TO_CHAR(SALARY * 12, 'FM999,999,990.00') AS ILLIK_MAAS
FROM HR.EMPLOYEES
ORDER BY SALARY DESC;


-- Task 3
SELECT
    FIRST_NAME,
    TO_CHAR(HIRE_DATE, 'DD.MM.YYYY') AS ISE_GIRIS,
    EXTRACT(YEAR FROM HIRE_DATE) AS IL,
    TO_CHAR(HIRE_DATE, 'FMMonth', 'NLS_DATE_LANGUAGE = ENGLISH') AS AY_ADI,
    TO_CHAR(HIRE_DATE, 'FMDay', 'NLS_DATE_LANGUAGE = ENGLISH') AS HEFTE_GUNU
FROM HR.EMPLOYEES
ORDER BY HIRE_DATE ASC;


-- Task 4
SELECT
    FIRST_NAME || ' ' || LAST_NAME AS ISCI,
    TO_CHAR(HIRE_DATE, 'FMDD Month YYYY', 'NLS_DATE_LANGUAGE = ENGLISH') AS ISE_GIRIS,
    TRUNC(MONTHS_BETWEEN(SYSDATE, HIRE_DATE) / 12) || ' il ' ||
    TRUNC(MOD(MONTHS_BETWEEN(SYSDATE, HIRE_DATE), 12)) || ' ay' AS STAJ
FROM HR.EMPLOYEES
ORDER BY MONTHS_BETWEEN(SYSDATE, HIRE_DATE) DESC;


-- Task 5
-- a)
SELECT
    FIRST_NAME,
    HIRE_DATE,
    ADD_MONTHS(HIRE_DATE, 3) AS SINAQ_BITIR,
    LAST_DAY(HIRE_DATE) AS ILK_MAAS_GUNU,
    TRUNC(LAST_DAY(HIRE_DATE)) - TRUNC(HIRE_DATE) AS MAASA_QALAN_GUN
FROM HR.EMPLOYEES;

-- b)
SELECT ADD_MONTHS(TO_DATE('28.02.2025', 'DD.MM.YYYY'), 3) AS NETICE
FROM DUAL;


-- Task 6
SELECT
    CONCAT(CONCAT(FIRST_NAME, ' '), LAST_NAME) || ', komissiya: ' ||
    NVL(TO_CHAR(COMMISSION_PCT, 'FM0.00'), 'yoxdur') AS MELUMAT
FROM HR.EMPLOYEES
WHERE TO_CHAR(HIRE_DATE, 'MM') = '03';


-- Task 7
SELECT
    TO_CHAR(HIRE_DATE, 'MM') AS AY_NO,
    TO_CHAR(HIRE_DATE, 'FMMonth', 'NLS_DATE_LANGUAGE = ENGLISH') AS AY,
    COUNT(*) AS ISCI_SAYI
FROM HR.EMPLOYEES
GROUP BY
    TO_CHAR(HIRE_DATE, 'MM'),
    TO_CHAR(HIRE_DATE, 'FMMonth', 'NLS_DATE_LANGUAGE = ENGLISH')
ORDER BY AY_NO ASC;


-- Task 8
SELECT
    EMPLOYEE_ID,
    LOWER(SUBSTR(FIRST_NAME, 1, 1) || LAST_NAME) || LPAD(EMPLOYEE_ID, 4, '0') AS LOGIN,
    REPLACE(PHONE_NUMBER, '.', '-') AS TELEFON
FROM HR.EMPLOYEES
WHERE LENGTH(LAST_NAME) >= 7
ORDER BY LOGIN ASC;


-- Task 9
SELECT
    EXTRACT(YEAR FROM HIRE_DATE) AS IL,
    COUNT(*) AS ISCI_SAYI,
    TO_CHAR(MIN(HIRE_DATE), 'DD.MM.YYYY') AS ILK_TARIX,
    TO_CHAR(MAX(HIRE_DATE), 'DD.MM.YYYY') AS SON_TARIX,
    TO_CHAR(AVG(SALARY), 'FM999,999,990.00') AS ORTA_MAAS
FROM HR.EMPLOYEES
GROUP BY EXTRACT(YEAR FROM HIRE_DATE)
ORDER BY IL ASC;


-- Task 10
-- a)
SELECT
    FIRST_NAME,
    INITCAP(TO_CHAR(HIRE_DATE, 'DY', 'NLS_DATE_LANGUAGE = ENGLISH')) || ', ' ||
    TO_CHAR(HIRE_DATE, 'DD.MM.YYYY') AS ISE_GIRIS,
    CASE
        WHEN TO_CHAR(HIRE_DATE, 'DY', 'NLS_DATE_LANGUAGE = ENGLISH') IN ('SAT', 'SUN')
            THEN 'Hefte sonu'
        ELSE 'Is gunu'
    END AS GUN_NOVU
FROM HR.EMPLOYEES;

-- b)
SELECT
    TO_CHAR(HIRE_DATE, 'FMDay', 'NLS_DATE_LANGUAGE = ENGLISH') AS GUN,
    COUNT(*) AS ISCI_SAYI
FROM HR.EMPLOYEES
GROUP BY TO_CHAR(HIRE_DATE, 'FMDay', 'NLS_DATE_LANGUAGE = ENGLISH')
ORDER BY ISCI_SAYI DESC;
