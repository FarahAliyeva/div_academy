-- TASK 1
SELECT FIRST_NAME,
       LAST_NAME,
       HIRE_DATE,
    CASE WHEN HIRE_DATE < TO_DATE('2003-01-01', 'YYYY-MM-DD') THEN 'VETERAN'
         WHEN HIRE_DATE BETWEEN TO_DATE('2003-01-01', 'YYYY-MM-DD') 
         AND TO_DATE('2006-12-31', 'YYYY-MM-DD') THEN 'TECRUBELI'
         ELSE 'YENI'
    END AS STAJ_QRUPU 
FROM HR.EMPLOYEES;






-- TASK 2 
SELECT DEPARTMENT_ID,
       DEPARTMENT_NAME,
    CASE DEPARTMENT_NAME
        WHEN 'Administration' THEN 'idaretme'
        WHEN 'Marketing' THEN 'marketing'
        WHEN 'Purchasing' THEN 'satinalma'
        WHEN 'Human Resources' THEN 'insan resurslari'
        ELSE 'diger sobe'
    END AS SOBE_AZ
FROM HR.DEPARTMENTS;






-- TASK 3
-- A
SELECT FIRST_NAME,
       DEPARTMENT_ID,
    CASE WHEN DEPARTMENT_ID IS NULL THEN 'SOBE TEYIN OLUNMAYIB'
         ELSE 'SOBE VAR'
    END AS SOBE_STATUSU
FROM HR.EMPLOYEES;

-- B
SELECT FIRST_NAME,
       DEPARTMENT_ID,
       NVL2(DEPARTMENT_ID, 'SOBE VAR', 'SOBE TEYIN OLUNMAYIB') AS SOBE_STATUSU
FROM HR.EMPLOYEES;






-- TASK 4 
SELECT JOB_ID,
       JOB_TITLE,
    CASE WHEN JOB_ID IN ('AD_PRES', 'AD_VP', 'FI_MGR', 'AC_MGR') THEN 'ALI REHBERLIK'
        WHEN JOB_ID IN ('IT-PROG', 'SA_REP', 'FI_ACCOUNT') THEN 'ESAS MUTEXESSIS'
        WHEN JOB_ID IN ('ST_CLERK', 'SH_CLERK', 'PU_CLERK') THEN 'OPERATIV ISCI'
        ELSE 'DIGER'
    END AS KATEQORIYA
FROM HR.JOBS;






-- TASK 5 
SELECT FIRST_NAME,
       DEPARTMENT_ID,
       SALARY,
    CASE DEPARTMENT_ID
       WHEN 50 THEN (SALARY * 0.08)
       WHEN 30 THEN (SALARY * 0.12)
       WHEN 100 THEN 400
       ELSE (SALARY * 0.04)
    END AS MUAVINET
FROM HR.EMPLOYEES
ORDER BY MUAVINET DESC;






-- TASK 6 
SELECT FIRST_NAME,
       COMMISSION_PCT,
       CASE WHEN COMMISSION_PCT IS NULL THEN 'YOXDUR'
            WHEN COMMISSION_PCT > 0.25 THEN 'YUKSEK'
            ELSE 'NORMAL'
        END AS KOMISIYA_NOVU
FROM HR.EMPLOYEES;






-- TASK 7
SELECT FIRST_NAME, 
       PHONE_NUMBER, 
       SALARY,
    CASE 
        WHEN PHONE_NUMBER LIKE '515%' THEN 'Daxili xett'
        WHEN SALARY >= 10000 THEN 'Yuksek maasli'
        WHEN COMMISSION_PCT IS NOT NULL THEN 'Satis komandasi'
        ELSE 'Standart isci'
    END AS KATEQORIYA
FROM HR.EMPLOYEES;






-- TASK 8
SELECT FIRST_NAME, 
       SALARY, 
       COMMISSION_PCT,
       NVL(SALARY * COMMISSION_PCT * 3, 0) AS RUBLUK_BONUS,
       (SALARY * 3) + NVL(SALARY * COMMISSION_PCT * 3, 0) AS RUBLUK_UMUMI
FROM HR.EMPLOYEES
ORDER BY RUBLUK_UMUMI ASC;






-- TASK 9
SELECT e.FIRST_NAME, 
       j.JOB_TITLE, 
       e.SALARY, 
       j.MIN_SALARY, 
       j.MAX_SALARY,
    CASE 
        WHEN e.SALARY = j.MAX_SALARY THEN 'Limite catib'
        WHEN (j.MAX_SALARY - e.SALARY) <= 2000 THEN 'Limite cox yaxin'
        WHEN e.SALARY < (j.MIN_SALARY + 1000) THEN 'Baslangic seviyyede'
        ELSE 'Orta araliqda'
    END AS MAAS_VEZIYYETI
FROM HR.EMPLOYEES e
JOIN HR.JOBS j 
ON e.JOB_ID = j.JOB_ID;












