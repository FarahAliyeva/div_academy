-- TASK 1
SELECT FIRST_NAME,
       UPPER(SUBSTR(FIRST_NAME, 1, 2)) || '-' || LOWER(SUBSTR(LAST_NAME, 1, 3)) AS KOD_AD,
       REPLACE(PHONE_NUMBER, '.', '') AS TELEFON_TEMIZ,
       LENGTH(FIRST_NAME || LAST_NAME) AS AD_UZUNLUQ
FROM HR.EMPLOYEES
ORDER BY AD_UZUNLUQ DESC;




-- TASK 2
SELECT FIRST_NAME,
       SALARY,
       NVL2(COMMISSION_PCT, NVL(TO_CHAR(COMMISSION_PCT * 100) || '%' ,'TEYIN OLUNMAYIB'), 'TEYIN OLUNMAYIB') AS KOMMISIYA_FAIZ,
       TO_CHAR(SALARY * NVL(COMMISSION_PCT,0), '$999,990.00') AS BONUS_MEBLEG
FROM HR.EMPLOYEES
WHERE SALARY > 5000
ORDER BY SALARY DESC;





-- Task 3 
SELECT CONCAT(
           CONCAT(
               CONCAT(
                   CONCAT(
                       CONCAT(FIRST_NAME, ' '),
                       LAST_NAME
                   ),
                   ' ['
               ),
               JOB_ID
           ),
           ']'
       ) AS ISCI_KARTI,
       TO_CHAR(HIRE_DATE, 'Q') AS GIRIS_RUBU,
       TO_NUMBER(TO_CHAR(HIRE_DATE, 'DDD')) AS ILIN_GUNU
FROM HR.EMPLOYEES;






-- TASK 4 
SELECT FIRST_NAME,
       TO_CHAR(HIRE_DATE, 'DD-Mon-YYYY', 'NLS_DATE_LANGUAGE = AMERICAN') AS ISE_GIRIS,
       TO_CHAR(NEXT_DAY(HIRE_DATE, 'MONDAY'), 'DD.MM.YYYY') AS TELIM_TARIXI,
       TRUNC(NEXT_DAY(HIRE_DATE, 'MONDAY')) - TRUNC(HIRE_DATE) AS GOZLEME_GUNU
FROM HR.EMPLOYEES
WHERE JOB_ID IN ('IT_PROG', 'SA_REP');










-- TASK 5
-- a) 
SELECT TRUNC(MONTHS_BETWEEN(SYSDATE, TO_DATE('15.10.1998', 'DD.MM.YYYY')) / 12) AS TAM_YAS
FROM DUAL;

-- b) 
SELECT TO_CHAR(ADD_MONTHS(TO_DATE('31.01.2025', 'DD.MM.YYYY'), 1), 'DD.MM.YYYY') AS YENI_TARIX
FROM DUAL;






-- TASK 6
SELECT FIRST_NAME,
       TO_CHAR(SALARY, '999,999') AS MAAS,
       TO_CHAR(HIRE_DATE, 'HH24') AS SAAT
FROM HR.EMPLOYEES
WHERE TO_CHAR(HIRE_DATE, 'FMMonth', 'NLS_DATE_LANGUAGE = AMERICAN') = 'May';






-- TASK 7
SELECT DEPARTMENT_ID,
       COUNT(*) AS ISCI_SAYI,
       TO_CHAR(MIN(HIRE_DATE), 'DD.MM.YYYY') AS ILK_ISCI_TARIX,
       TO_CHAR(MAX(HIRE_DATE), 'DD.MM.YYYY') AS SON_ISCI_TARIX,
       TRUNC(MAX(HIRE_DATE)) - TRUNC(MIN(HIRE_DATE)) AS GUN_FERQI
FROM HR.EMPLOYEES
WHERE DEPARTMENT_ID IS NOT NULL
GROUP BY DEPARTMENT_ID
ORDER BY DEPARTMENT_ID ASC;




-- TASK 8
SELECT 'EMP-' || LPAD(EMPLOYEE_ID, 5, '0') || '-' ||
       UPPER(SUBSTR(FIRST_NAME, 1, 1) || SUBSTR(LAST_NAME, 1, 1)) AS KART_NO,
       LAST_NAME,
       LENGTH(EMAIL) AS EMAIL_UZUNLUQ,
       INSTR(LAST_NAME, 'a') AS ILK_HERF_YERI
FROM HR.EMPLOYEES
WHERE INSTR(LAST_NAME, 'a') > 0;




-- TASK 9 
SELECT TO_NUMBER(TO_CHAR(HIRE_DATE, 'Q')) AS RUB,
       TO_CHAR(HIRE_DATE, 'MM') AS AY_NO,
       TO_CHAR(HIRE_DATE, 'FMMonth', 'NLS_DATE_LANGUAGE = AMERICAN') AS AY_ADI,
       COUNT(*) AS ISCI_SAYI,
       TRIM(TO_CHAR(SUM(SALARY), '$999,999,990')) AS CEMI_MAAS
FROM HR.EMPLOYEES
GROUP BY TO_NUMBER(TO_CHAR(HIRE_DATE, 'Q')),
         TO_CHAR(HIRE_DATE, 'MM'),
         TO_CHAR(HIRE_DATE, 'FMMonth', 'NLS_DATE_LANGUAGE = AMERICAN')
ORDER BY RUB ASC, AY_NO ASC;







-- TASK 10
-- a) 
SELECT FIRST_NAME,
       HIRE_DATE,
       TO_CHAR(TRUNC(HIRE_DATE, 'YEAR'), 'DD.MM.YYYY') AS ILIN_ILK_GUNU,
       TO_CHAR(ADD_MONTHS(TRUNC(HIRE_DATE, 'YEAR'), 12) - 1, 'DD.MM.YYYY') AS ILIN_SON_GUNU,
       (ADD_MONTHS(TRUNC(HIRE_DATE, 'YEAR'), 12) - 1) - TRUNC(HIRE_DATE) AS ILE_QALAN_GUN
FROM HR.EMPLOYEES;

-- b) 
SELECT FIRST_NAME, HIRE_DATE
FROM HR.EMPLOYEES
WHERE HIRE_DATE >= TRUNC(SYSDATE)
  AND HIRE_DATE < TRUNC(SYSDATE) + 1;
